# Database (defaults match docker-compose.yml)
# Docker Compose reads DB_PORT for the published port. The backend does not read
# this file; use the `local` Spring profile instead (see README).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=faktura
DB_USER=faktura
DB_PASSWORD=faktura

# Frontend dev server (optional)
VITE_API_BASE_URL=http://localhost:8080
